@node Manual Installation
@section Manual

Download @file{dired-image-thumbnail.el} and place it in your load-path:

@lisp
(add-to-list 'load-path "/path/to/dired-image-thumbnail/")
(require 'dired-image-thumbnail)
@end lisp

@node use-package
@section use-package

@lisp
(use-package dired-image-thumbnail
  :load-path "/path/to/dired-image-thumbnail/"
  :demand t)
@end lisp

@node straight.el
@section straight.el

@lisp
(straight-use-package
 '(dired-image-thumbnail :type git :host github
                         :repo "captainflasmr/dired-image-thumbnail"))
@end lisp

